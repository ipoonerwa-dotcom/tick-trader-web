# Public settings baked into the production build. Nothing here is secret.
# Site origin, used for link-preview images, e.g. https://ticktrader.xyz
VITE_SITE_URL=https://www.ticktraderai.io
# The desk bot's API, e.g. https://api.ticktrader.xyz (empty = same origin)
VITE_API_BASE=https://api.ticktraderai.io
# The project's X profile (the link is hidden until set)
VITE_X_URL=https://x.com/TickTraderAI
